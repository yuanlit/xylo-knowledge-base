{
  "name": "xylo-knowledge-base",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "postinstall": "node scripts/prepare-companion-assets.mjs",
    "predev": "node scripts/prepare-companion-assets.mjs",
    "prebuild": "npm run icons:generate && node scripts/prepare-companion-assets.mjs",
    "icons:generate": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/generate-extension-icons.ps1",
    "dev": "vite --config vite.extension.config.mts",
    "dev:extension": "npm run dev",
    "build": "tsc --noEmit && vite build --config vite.extension.config.mts && node scripts/finalize-extension-build.mjs",
    "build:extension": "npm run build",
    "lint": "eslint .",
    "test": "node scripts/test-file-operations.cjs",
    "library:migrate": "node scripts/migrate-library.mjs",
    "images:clean": "node scripts/clean-unused-images.mjs"
  },
  "dependencies": {
    "@uiw/react-md-editor": "^4.0.11",
    "canvas-nest.js": "^2.0.4",
    "fuse.js": "^7.1.0",
    "live2d-widget-model-hibiki": "^1.0.5",
    "live2d-widget-model-hijiki": "^1.0.5",
    "live2d-widget-model-izumi": "^1.0.5",
    "live2d-widget-model-koharu": "^1.0.5",
    "live2d-widget-model-ni-j": "^1.0.5",
    "live2d-widget-model-nico": "^1.0.5",
    "live2d-widget-model-nipsilon": "^1.0.5",
    "live2d-widget-model-nito": "^1.0.5",
    "live2d-widget-model-shizuku": "^1.0.5",
    "live2d-widget-model-tororo": "^1.0.5",
    "live2d-widget-model-z16": "^1.0.5",
    "lucide-react": "^1.56.0",
    "mermaid": "^11.12.2",
    "motion": "^14.2.0",
    "oh-my-live2d": "^0.19.3",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-zoom-pan-pinch": "^3.7.0",
    "sonner": "^2.0.7",
    "yaml": "^2.9.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/chrome": "^0.2.2",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/wicg-file-system-access": "^2023.10.7",
    "@vitejs/plugin-react": "^6.0.4",
    "@eslint/js": "^9",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint": "^9",
    "typescript-eslint": "^8.46.0",
    "tailwindcss": "^4",
    "typescript": "^5",
    "vite": "^8.1.5"
  }
}
